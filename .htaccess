Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Only the entry points are reachable. User data, temp files, CSVs and the library are not.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)(data|temp)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    # plugin PHP is loaded by the app, never requested directly; only plugins/<id>/*.js|css are served
    RewriteRule (^|/)plugins/(.*\.php$|lib/) - [F,L]
</IfModule>
<FilesMatch "\.(csv|md|json)$|^(config|lib|shell)\.php$">
    Require all denied
</FilesMatch>

# Only applies with mod_php; on PHP-FPM set these in php.ini instead (defaults are fine:
# uploads are sent in 1.75 MB chunks).
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value max_execution_time 300
</IfModule>
